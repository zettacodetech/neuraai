FROM ollama/ollama:latest

# NVIDIA GPU support (Railway 48GB GPU uchun)
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Modellarni oldindan yuklash (container build vaqtida)
# Bu juda katta bo'ladi, shuning uchun runtime da yuklash yaxshiroq
# RUN ollama serve & sleep 10 && \
#     ollama pull deepseek-r1:7b && \
#     ollama pull llama3.3:8b && \
#     ollama pull qwen2.5-coder:7b && \
#     ollama pull gemma2:9b && \
#     ollama pull mistral:7b && \
#     ollama pull phi3:14b

# Runtime da model yuklash uchun script
COPY pull-models.sh /pull-models.sh
RUN chmod +x /pull-models.sh

EXPOSE 11434

# Ollama server + modellarni yuklash
CMD ["/bin/sh", "-c", "/pull-models.sh"]