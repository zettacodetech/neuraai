# Neura AI CLI xizmati — opencode + kilo + aider + ollama + neura_cli
# Railway'da web terminal orqali ishlatish uchun
FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

# Asosiy paketlar
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv curl git bash tzdata \
    && rm -rf /var/lib/apt/lists/*

# Ollama (mahalliy modellar uchun)
RUN curl -fsSL https://ollama.com/install.sh | sh || true

# Kilo Code CLI
RUN npm install -g @kilocode/cli

# OpenCode CLI
RUN curl -fsSL https://opencode.ai/install | bash || true
ENV PATH="/root/.opencode/bin:${PATH}"

# Aider
RUN pip3 install --no-cache-dir aider-chat

# neura_cli — backend kodini ko'chirish
WORKDIR /app
COPY backend/ /app/

# CLI uchun venv (asosiy tizimni buzmaydi)
RUN python3 -m venv /app/.clivenv \
    && /app/.clivenv/bin/pip install --no-cache-dir typer rich

# Kichik modelni yuklab olish uchun entrypoint
COPY cli-service/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8080
ENTRYPOINT ["/entrypoint.sh"]